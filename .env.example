# Empty means "use relative paths", which the Vite dev proxy forwards to the
# backend. Set an absolute origin (e.g. https://api.example.com) only when the
# frontend is deployed separately from the API.
VITE_API_BASE=

# Dev-only: where the Vite proxy forwards /api and /uploads.
# Defaults to http://127.0.0.1:8000 when unset.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
