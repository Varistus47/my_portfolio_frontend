# Where the browser sends API calls.
#
# Set to the backend's own origin, so requests go straight to port 8000 and
# show up as 127.0.0.1:8000 in the DevTools Network tab. Because this is now a
# cross-origin request, the backend's CORS settings apply (CORS_ORIGINS in
# backend/portfolio_backend/.env already allows the Vite dev origins).
#
# Use 127.0.0.1, not localhost: uvicorn is started with --host 127.0.0.1, so it
# listens on IPv4 only, and `localhost` can resolve to ::1 first.
#
# Leave this EMPTY instead to use the Vite dev proxy, which keeps everything
# same-origin on port 5173 and avoids CORS entirely.
VITE_API_BASE=http://127.0.0.1:8000

# Dev-only: where the Vite proxy forwards /api and /uploads. Only used when
# VITE_API_BASE is empty. Defaults to http://127.0.0.1:8000 when unset.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
